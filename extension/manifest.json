{
  "manifest_version": 3,
  "name": "Notes Stream",
  "version": "1.0.0",
  "description": "Smart AI notebook for YouTube videos.",
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["src/content.jsx"]
    }
  ]
}